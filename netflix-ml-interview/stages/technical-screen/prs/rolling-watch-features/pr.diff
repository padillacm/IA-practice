+++ b/features/rolling_watch.py
@@ -0,0 +1,35 @@
+"""Rolling watch features for the title-click ranker (7-day window)."""
+import pandas as pd
+
+WINDOW_DAYS = 7
+
+
+def build_features(events: pd.DataFrame, labels: pd.DataFrame) -> pd.DataFrame:
+    """Return one row per label with rolling watch features.
+
+    events: user_id, title_id, played_at (client-local timestamp string), minutes
+    labels: user_id, label_ts (UTC impression time), clicked
+    """
+    events["played_at"] = pd.to_datetime(events["played_at"])
+    labels["label_ts"] = pd.to_datetime(labels["label_ts"]).dt.tz_localize(None)
+
+    joined = labels.merge(events, on="user_id", how="left")
+    start = joined["label_ts"].dt.normalize() - pd.Timedelta(days=WINDOW_DAYS)
+    in_window = (joined["played_at"].dt.normalize() >= start) & (
+        joined["played_at"].dt.normalize() <= joined["label_ts"].dt.normalize()
+    )
+    window = joined[in_window]
+
+    grouped = window.groupby(["user_id", "label_ts"])
+    feats = grouped.agg(
+        watch_minutes_7d=("minutes", "sum"),
+        distinct_titles_7d=("title_id", "nunique"),
+        last_play=("played_at", "max"),
+    ).reset_index()
+    feats["days_since_last_play"] = (feats["label_ts"] - feats["last_play"]).dt.days
+
+    out = labels.merge(feats, on=["user_id", "label_ts"], how="left")
+    out[["watch_minutes_7d", "distinct_titles_7d", "days_since_last_play"]] = out[
+        ["watch_minutes_7d", "distinct_titles_7d", "days_since_last_play"]
+    ].fillna(0)
+    return out.drop(columns=["last_play"])
