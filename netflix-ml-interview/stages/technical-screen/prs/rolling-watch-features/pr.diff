+++ b/tests/test_rolling_watch.py
@@ -0,0 +1,22 @@
+import pandas as pd
+
+from features.rolling_watch import build_features
+
+
+def test_basic_window():
+    events = pd.DataFrame(
+        {
+            "user_id": [1, 1, 2],
+            "title_id": [10, 11, 10],
+            "played_at": ["2026-03-01 20:00:00", "2026-03-05 21:00:00", "2026-02-01 10:00:00"],
+            "minutes": [30, 45, 60],
+        }
+    )
+    labels = pd.DataFrame(
+        {"user_id": [1, 2], "label_ts": ["2026-03-06 12:00:00", "2026-03-06 12:00:00"], "clicked": [1, 0]}
+    )
+    out = build_features(events, labels).set_index("user_id")
+    assert out.loc[1, "watch_minutes_7d"] == 75
+    assert out.loc[1, "distinct_titles_7d"] == 2
+    assert out.loc[2, "watch_minutes_7d"] == 0
+    assert out.loc[1, "days_since_last_play"] == 0
