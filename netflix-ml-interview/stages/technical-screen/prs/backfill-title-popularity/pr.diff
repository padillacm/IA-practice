+"""Backfill daily title popularity into the feature warehouse table."""
+from datetime import datetime
+
+import pandas as pd
+from sklearn.preprocessing import LabelEncoder
+
+
+def backfill(conn, start, end):
+    """Recompute title_popularity_daily for every day in [start, end]."""
+    for day in pd.date_range(start, end):
+        d = day.strftime("%Y-%m-%d")
+        plays = pd.read_sql(
+            f"SELECT title_id, user_id FROM plays WHERE play_date = '{d}'", conn
+        )
+        meta = pd.read_sql("SELECT title_id, genre FROM titles_history", conn)
+
+        daily = plays.groupby("title_id").size().rename("plays").reset_index()
+        daily = daily.merge(meta, on="title_id")
+
+        overall = pd.read_sql("SELECT AVG(plays) AS m FROM title_popularity_daily", conn)["m"][0]
+        daily["plays"] = daily["plays"].fillna(overall)
+        daily["pop_norm"] = daily["plays"] / daily["plays"].max()
+        daily["title_code"] = LabelEncoder().fit_transform(daily["title_id"])
+        daily["day"] = d
+        daily["computed_at"] = datetime.utcnow()
+
+        daily.to_sql("title_popularity_daily", conn, if_exists="append", index=False)
diff --git a/tests/test_backfill_popularity.py b/tests/test_backfill_popularity.py
