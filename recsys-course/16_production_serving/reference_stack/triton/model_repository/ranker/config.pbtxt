# Ranker MLP exportado a ONNX en la lección (artifacts/ranker.onnx → copiar a ranker/1/model.onnx)
name: "ranker"
backend: "onnxruntime"
max_batch_size: 4096
input [
  { name: "x", data_type: TYPE_FP32, dims: [ 7 ] }   # 7 features de RANK_FEATS (orden fijo: ¡contrato!)
]
output [
  { name: "p", data_type: TYPE_FP32, dims: [ ] }
]
# Junta peticiones de distintos usuarios hasta 500 µs para aprovechar la GPU
dynamic_batching {
  preferred_batch_size: [ 512, 1024 ]
  max_queue_delay_microseconds: 500
}
instance_group [ { kind: KIND_GPU, count: 2 } ]
# Para tree models (LightGBM/XGBoost) existe el backend FIL: backend: "fil"
