{
  "$schema": "https://langgra.ph/schema.json",
  "python_version": "3.11",
  "dependencies": ["."],
  "graphs": {
    "soporte": "./mi_agente/grafo.py:grafo"
  },
  "env": "../.env",

  "auth": {
    "path": "./mi_agente/auth.py:auth",
    "disable_studio_auth": false
  },

  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "sweep_interval_minutes": 60,
      "default_ttl": 43200
    }
  },

  "store": {
    "ttl": {
      "refresh_on_read": true,
      "sweep_interval_minutes": 120,
      "default_ttl": 10080
    }
  },

  "http": {
    "cors": {
      "allow_origins": ["https://app.ejemplo.com"],
      "allow_methods": ["GET", "POST", "DELETE"],
      "allow_credentials": true,
      "max_age": 600
    },
    "disable_meta": true,
    "disable_store": true,
    "disable_mcp": true,
    "disable_a2a": true
  }
}
