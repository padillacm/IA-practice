# Copia este fichero a `.env` (en la misma carpeta) y rellena tus claves.
# `.env` está en .gitignore: nunca subas claves al repositorio.

# --- obligatoria ----------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- muy recomendable -----------------------------------------------------
# LangSmith traza cada nodo, cada llamada al modelo y cada herramienta.
# Depurar un grafo sin trazas es adivinar. https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=curso-langgraph

# --- opcional -------------------------------------------------------------
# Modelo por defecto de todos los notebooks (utils/curso.py lo lee).
# LANGGRAPH_CURSO_MODELO=gpt-4o-mini

# Búsqueda web real para los agentes del módulo 4 (si no está, se usa un
# buscador simulado sobre el corpus local y los notebooks siguen funcionando).
# TAVILY_API_KEY=tvly-...
