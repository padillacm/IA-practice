# Copia este fichero a `.env` (que está en .gitignore) y rellena lo tuyo.
#
# El curso funciona SIN nada de esto: en modo local se ejecuta entero y enseña
# todo lo que no necesita el servicio. Las claves solo activan las celdas @online.

# --- LangSmith -----------------------------------------------------------------
# https://smith.langchain.com -> Settings -> API Keys. Empieza por `lsv2_pt_`.
LANGSMITH_API_KEY=

# Proyecto donde caen las trazas. Aparte del tuyo de trabajo, a propósito.
LANGSMITH_PROJECT=curso-langsmith

# Región. Europa: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# El interruptor general. `utils.curso.init()` lo pone solo según haya clave o no,
# así que no hace falta tocarlo aquí; se deja documentado porque es la variable que
# más se busca.
# LANGSMITH_TRACING=true

# --- OpenAI --------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
