          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_duration_seconds_bucket{service_name=\"supportops-agent\"}[5m])))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
