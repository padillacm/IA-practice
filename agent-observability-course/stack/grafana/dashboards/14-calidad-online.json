    {
      "type": "stat",
      "title": "Calidad estimada (groundedness, post-estratificada)",
      "description": "Tasa de respuestas fundamentadas en los últimos 5 min, ponderada por el tamaño real de cada estrato.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(sum by (supportops_eval_stratum) (rate(supportops_eval_population_total[5m])) * (sum by (supportops_eval_stratum) (rate(supportops_eval_results_total{gen_ai_evaluation_name=\"groundedness\",gen_ai_evaluation_score_label=\"pass\"}[5m])) / sum by (supportops_eval_stratum) (rate(supportops_eval_results_total{gen_ai_evaluation_name=\"groundedness\"}[5m])))) / sum(rate(supportops_eval_population_total[5m]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
        }
