          "expr": "sum by (gen_ai_tool_name) (increase(mcp_client_operation_duration_seconds_sum[$__range])) / sum by (gen_ai_tool_name) (increase(mcp_client_operation_duration_seconds_count[$__range])) - on(gen_ai_tool_name) sum by (gen_ai_tool_name) (increase(mcp_server_operation_duration_seconds_sum[$__range])) / sum by (gen_ai_tool_name) (increase(mcp_server_operation_duration_seconds_count[$__range]))",
