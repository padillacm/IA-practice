    {
      "type": "table",
      "title": "Trazas sospechosas de v2 (Tempo)",
      "description": "Tickets de v2 sobre pedidos/reembolsos sin ninguna herramienta: la huella estructural de la regresión.",
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ name =~ \"invoke_agent.*\" && span.gen_ai.agent.version = \"v2\" && span.supportops.tool_calls = 0 && span.supportops.intent =~ \"order_status|refund\" }",
          "limit": 20,
          "tableType": "traces",
          "filters": [],
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
