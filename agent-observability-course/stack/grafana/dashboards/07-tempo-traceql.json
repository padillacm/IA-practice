            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "fracción de spans con error por servicio",
      "description": "Razón de dos consultas TraceQL metrics (aritmética, Tempo 3.1): spans en error / spans totales por servicio.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "({ status = error } | rate() by (resource.service.name)) / ({ } | rate() by (resource.service.name))",
          "limit": 20,
          "tableType": "spans",
          "filters": [],
          "refId": "A",
          "metricsQueryType": "range",
          "step": ""
