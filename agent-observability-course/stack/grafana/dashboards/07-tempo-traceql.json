      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "p95 de latencia por servicio",
      "description": "histogram_quantile sobre traces_spanmetrics_latency_bucket (span metrics).",
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
