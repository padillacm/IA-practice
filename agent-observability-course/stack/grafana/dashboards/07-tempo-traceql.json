      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "id": 4
    },
    {
      "type": "row",
      "id": 5,
      "title": "TraceQL metrics (se calculan al consultar)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "spans/s por servicio",
      "description": "TraceQL metrics: rate() por servicio, calculado al consultar sobre los spans almacenados (hora del span).",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ } | rate() by (resource.service.name)",
          "limit": 20,
          "tableType": "spans",
          "filters": [],
          "refId": "A",
          "metricsQueryType": "range",
          "step": ""
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
