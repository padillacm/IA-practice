    {
      "type": "row",
      "id": 5,
      "title": "Errores y latencia desde logs de acceso (logfmt)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "5xx por ruta",
      "description": "Errores 5xx/s por ruta a partir de logs de acceso. Las señales permanentes deberían ser métricas (módulo 09).",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (route) (rate({service_name=~\".+-access\"} | logfmt | status >= 500 [5m]))",
          "legendFormat": "{{route}}",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
