      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (level) (count_over_time({service_name=\"supportops-agent-json\"} | json [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A"
        }
      ],
