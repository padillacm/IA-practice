            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "p95 de duration_ms por servicio",
      "description": "Latencia p95 desde logs (unwrap de duration_ms). Estimación; la fuente correcta para SLOs son los histogramas.",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service_name=~\".+-access\"} | logfmt | unwrap duration_ms [$__auto]) by (service_name)",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
