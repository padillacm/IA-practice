    {
      "type": "text",
      "title": "Cómo leerlo",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": false,
      "options": {
        "mode": "markdown",
        "content": "Streams: `supportops-agent` (OTLP), `supportops-agent-json` (JSON) y `*-access` (logfmt de `llm-gateway`, `orders-api`, `kb-search`). En las líneas, el metadato **trace_id** abre la traza en Tempo (derived field). Variable `trace_id` para ver los logs de una petición."
      },
      "id": 1
    },
    {
      "type": "row",
      "id": 2,
      "title": "Volumen y niveles",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "líneas por servicio",
      "description": "Volumen de logs por stream (índice: service_name). Una subida brusca suele ser un bucle de errores.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({deployment_environment_name=\"lab\"}[$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "líneas por nivel (agente JSON)",
