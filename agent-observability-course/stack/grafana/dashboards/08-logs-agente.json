    },
    {
      "type": "logs",
      "title": "Errores y avisos del agente",
      "description": "Líneas JSON con nivel warn/error. Abre una línea y pulsa «Ver traza en Tempo».",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"supportops-agent-json\"} | json | level=~\"warn|error\"",
          "legendFormat": "",
          "queryType": "range",
          "maxLines": 200,
          "refId": "A"
