          "editorMode": "code",
          "expr": "sum(rate(supportops_agent_requests_total{service_name=\"supportops-agent\",supportops_status=~\"ok|escalated\"}[30m])) / sum(rate(supportops_agent_requests_total{service_name=\"supportops-agent\"}[30m]))",
          "legendFormat": "__auto",
          "range": true,
          "instant": false,
          "refId": "A"
